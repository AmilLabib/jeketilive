# Frontend (browser) — semua VITE_* ikut terkirim ke browser, JANGAN isi kunci rahasia di sini
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Pakai kunci "anon" / "publishable", BUKAN service_role
VITE_SUPABASE_ANON_KEY=
# URL Cloudflare Worker (worker/) untuk video IDN. Kosongkan di lokal (pakai /hls dari dev server, lewat IP Indonesia lu).
VITE_HLS_PROXY_URL=

# Server (Vercel functions) – jangan pakai prefix VITE_
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
